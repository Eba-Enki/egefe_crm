# ─── GÜVENLİK HEADER'LARI ────────────────────────────────────────────────────

<IfModule mod_headers.c>
    # Tarayıcının içerik türünü tahmin etmesini engelle
    Header always set X-Content-Type-Options "nosniff"

    # Sayfanın iframe içinde açılmasını engelle (clickjacking koruması)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer bilgisini sınırla
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Gereksiz tarayıcı izinlerini kapat
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"

    # Content Security Policy
    # 'unsafe-inline' gerekli: tüm stiller index.html içinde inline, onclick handler'lar JS içinde
    # Google Fonts CDN'den yükleniyor (fonts.googleapis.com / fonts.gstatic.com)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://placehold.co; connect-src 'self'; object-src 'none'; base-uri 'self'"
</IfModule>

# ─── ERİŞİM KISITLAMALARI ─────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On
    # .git, .github gibi gizli klasörlere web erişimini engelle
    RewriteRule ^\.git(hub)?(/|$) - [F,L]
</IfModule>

# ─── SIKIŞTIRMA ──────────────────────────────────────────────────────────────

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ─── ÖNBELLEK ────────────────────────────────────────────────────────────────

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
